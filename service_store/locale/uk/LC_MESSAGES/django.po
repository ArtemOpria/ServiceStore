# Загальні переклади для адмін-панелі
msgid "Django administration"
msgstr "Адміністрування Django"

msgid "Site administration"
msgstr "Адміністрування сайту"

msgid "Log in"
msgstr "Увійти"

msgid "Log out"
msgstr "Вийти"

msgid "Username:"
msgstr "Ім'я користувача:"

msgid "Password:"
msgstr "Пароль:"

msgid "Please correct the error below."
msgid_plural "Please correct the errors below."
msgstr[0] "Будь ласка, виправте помилку нижче."
msgstr[1] "Будь ласка, виправте помилки нижче."
msgstr[2] "Будь ласка, виправте помилки нижче."

msgid "Please enter the correct %(username)s and password for a staff account. Note that both fields may be case-sensitive."
msgstr "Будь ласка, введіть правильні %(username)s та пароль для облікового запису персоналу. Зверніть увагу, що обидва поля можуть бути чутливими до регістру."

msgid "Action:"
msgstr "Дія:"

msgid "Add"
msgstr "Додати"

msgid "Add %(name)s"
msgstr "Додати %(name)s"

msgid "Change"
msgstr "Змінити"

msgid "Change %(name)s"
msgstr "Змінити %(name)s"

msgid "Delete"
msgstr "Видалити"

msgid "Delete selected %(verbose_name_plural)s"
msgstr "Видалити вибрані %(verbose_name_plural)s"

msgid "Save"
msgstr "Зберегти"

msgid "Save and add another"
msgstr "Зберегти та додати інший"

msgid "Save and continue editing"
msgstr "Зберегти та продовжити редагування"

msgid "Save as new"
msgstr "Зберегти як новий"

msgid "Close"
msgstr "Закрити"

# Повідомлення про помилки
msgid "Required. 30 characters or fewer. Letters, digits and @/./+/-/_ only."
msgstr "Обов'язкове. 30 символів або менше. Лише літери, цифри та @/./+/-/_."

msgid "This field is required."
msgstr "Це поле обов'язкове."

msgid "Enter a valid email address."
msgstr "Введіть дійсну електронну адресу."

# Заголовки сторінок
msgid "Home"
msgstr "Головна"

msgid "View site"
msgstr "Переглянути сайт"

msgid "Documentation"
msgstr "Документація"

msgid "Change password"
msgstr "Змінити пароль"

msgid "Recent actions"
msgstr "Останні дії"

msgid "My actions"
msgstr "Мої дії"

# Фільтри та пошук
msgid "Filter"
msgstr "Фільтр"

msgid "Search"
msgstr "Пошук"

msgid "Clear all filters"
msgstr "Очистити всі фільтри"

# Пагінація
msgid "Show all"
msgstr "Показати все"

msgid "%(count)s of %(full_result_count)s"
msgstr "%(count)s з %(full_result_count)s"

# Дати та час
msgid "Today"
msgstr "Сьогодні"

msgid "Now"
msgstr "Зараз"

msgid "Yesterday"
msgstr "Вчора"

msgid "Tomorrow"
msgstr "Завтра"

# Статуси
msgid "Yes"
msgstr "Так"

msgid "No"
msgstr "Ні"

msgid "Unknown"
msgstr "Невідомо"

msgid "None"
msgstr "Немає"

# Інші
msgid "All"
msgstr "Всі"

msgid "Choose"
msgstr "Вибрати"

msgid "Choose a time"
msgstr "Виберіть час"

msgid "Choose a date"
msgstr "Виберіть дату"

msgid "Choose all"
msgstr "Вибрати все"

msgid "Choose a value"
msgstr "Виберіть значення"

msgid "Empty"
msgstr "Порожньо"

msgid "Dashboard"
msgstr "Панель керування"

msgid "Please enter your old password, for security's sake, and then enter your new password twice so we can verify you typed it in correctly."
msgstr "Будь ласка, введіть свій старий пароль з міркувань безпеки, а потім двічі введіть новий пароль, щоб ми могли перевірити, чи правильно ви його ввели."
